{
	"name": "xeokit-iframe-viewer",
	"version": "1.5.0",
	"description": "Open-source (AGPL-3.0) xeokit 3D model viewer, embeddable in a host application via an iframe + postMessage boundary.",
	"license": "AGPL-3.0-only",
	"private": false,
	"author": "bimini-dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bimini-dev/xeokit-iframe-viewer.git"
	},
	"homepage": "https://github.com/bimini-dev/xeokit-iframe-viewer#readme",
	"bugs": {
		"url": "https://github.com/bimini-dev/xeokit-iframe-viewer/issues"
	},
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": "26.9.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"lint:prettier": "prettier --check .",
		"lint:eslint": "eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@xeokit/xeokit-sdk": "^2.6.114"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.6.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^7.3.6"
	}
}
